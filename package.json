{
  "name": "apigaze-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "APIGaze - Chromium DevTools extension for inspecting Fetch and XHR requests with a beautiful JSON tree view. Works on Chrome, Edge, and other Chromium browsers.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check": "node --experimental-strip-types src/capture/self-check.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.11",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
